{
  "name": "obsidian-artifacts-plugin",
  "version": "1.0.0",
  "description": "Render interactive HTML/CSS/JS inside Obsidian notes via html-render code blocks",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "html",
    "interactive",
    "artifacts"
  ],
  "author": "tj",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "latest",
    "tslib": "2.8.0",
    "typescript": "5.7.2",
    "vitest": "^3.0.0"
  }
}
